---
import { render, type CollectionEntry } from 'astro:content';
import TextPage from './TextPage.astro';

interface Props {
  entry: CollectionEntry<'legal'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const sections = headings.filter((heading) => heading.depth === 2).map(({ slug, text }) => ({ slug, text }));

const effective = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(entry.data.effective);
---

<TextPage title={entry.data.title} description={entry.data.description} eyebrow="Legal" sections={sections}>
  <p class="meta" slot="masthead">Version {entry.data.version} &middot; Effective {effective}</p>
  <Content />
</TextPage>
