---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const navLinks = [
  { name: 'Features', href: '/#features' },
  { name: 'Pricing', href: '/#pricing' },
  { name: 'FAQ', href: '/#faq' },
  { name: 'Support', href: '/support/' },
  { name: 'Privacy Policy', href: '/privacy/', menuOnly: true },
  { name: 'Terms', href: '/terms/', menuOnly: true },
];
const productHunt = {
  href: 'https://www.producthunt.com/products/gleamit-dental-health-tracker?embed=true&utm_source=badge-featured&utm_medium=badge&utm_campaign=badge-gleamit-dental-health-tracker',
  alt: 'Gleamit: Dental Health Tracker - Your dental health in one place - all private by design. | Product Hunt',
  embed: 'https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1254727&theme=',
};
const peerlist = {
  href: 'https://peerlist.io/uaitt/project/gleamit-dental-health-tracker',
  alt: 'Gleamit: Dental Health Tracker | Peerlist',
  embed: 'https://peerlist.io/api/v1/projects/embed/PRJHOK8AG69PKM79R17AMMOLEAABQG?showUpvote=true&theme=',
};
const sideProjectors = {
  href: 'https://www.sideprojectors.com/project/96547/gleamit-dental-health-tracker',
  alt: 'Check out Gleamit: Dental Health Tracker at @SideProjectors',
  image: '/badges/sideprojectors.png',
};
const startupBase = {
  href: 'https://startupbase.io/products/gleamit?utm_source=startupbase&utm_medium=badge&utm_campaign=featured-badge-neutral',
  alt: 'Featured on StartupBase',
  embed: 'https://statics.startupbase.io/site/badges/featured-on-sb',
};
const footerLinks = [
  { name: 'Privacy Policy', href: '/privacy/' },
  { name: 'Terms', href: '/terms/' },
  { name: 'Support', href: '/support/' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#E7F2EC" />
    <script is:inline>
      document.documentElement.dataset.theme = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light';
      if (document.documentElement.dataset.theme === 'dark') {
        document.querySelector('meta[name="theme-color"]').content = '#111418';
      }
    </script>
    <meta property="og:site_name" content="Gleamit" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="500" />
    <meta property="og:image:alt" content="Gleamit: the oral hygiene tracker that keeps everything on your phone" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <slot name="head" />
  </head>
  <body>
    <nav aria-label="Main">
      <div class="wrap">
        <a class="brand" href="/"><img src="/icon.svg" alt="" width="32" height="32" /> Gleamit</a>
        <div class="nav-right">
          <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="nav-menu" hidden>
            <svg class="bars" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            <svg class="close" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
          </button>
          <ul id="nav-menu">
            {navLinks.map((link) => (
              <li class:list={{ 'menu-only': link.menuOnly }}><a href={link.href}>{link.name}</a></li>
            ))}
          </ul>
          <button class="theme-toggle" type="button" aria-label="Switch to dark theme" aria-pressed="false" hidden>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          </button>
        </div>
      </div>
    </nav>
    <main>
      <slot />
    </main>
    <footer>
      <div class="wrap links">
        <a class="brand" href="/"><img src="/icon.svg" alt="" width="32" height="32" /> Gleamit</a>
        <ul>
          {footerLinks.map((link) => (
            <li><a href={link.href}>{link.name}</a></li>
          ))}
          <li class="copyright">© {new Date().getFullYear()} Lorenzo Zabot</li>
        </ul>
      </div>
      <div class="wrap badges">
        <a class="product-hunt" href={productHunt.href} target="_blank" rel="noopener noreferrer">
          <img
            src={`${productHunt.embed}light`}
            alt={productHunt.alt}
            width="250"
            height="54"
            loading="lazy"
          />
        </a>
        <a class="startup-base" href={startupBase.href} target="_blank" rel="noopener noreferrer">
          <img
            src={`${startupBase.embed}.svg`}
            alt={startupBase.alt}
            width="300"
            height="80"
            loading="lazy"
          />
        </a>
        <a class="peerlist" href={peerlist.href} target="_blank" rel="noopener noreferrer">
          <img
            src={`${peerlist.embed}light`}
            alt={peerlist.alt}
            width="296"
            height="72"
            loading="lazy"
          />
        </a>
        <a class="side-projectors" href={sideProjectors.href} target="_blank" rel="noopener noreferrer">
          <img
            src={sideProjectors.image}
            alt={sideProjectors.alt}
            width="242"
            height="70"
            loading="lazy"
          />
        </a>
      </div>
    </footer>
    <script is:inline>
      {
        const root = document.documentElement;
        const toggle = document.querySelector('.theme-toggle');
        const themeColor = document.querySelector('meta[name="theme-color"]');
        const badge = document.querySelector('.badge img.app-store');
        const productHunt = document.querySelector('.product-hunt img');
        const productHuntEmbed =
          'https://api.producthunt.com/widgets/embed-image/v1/featured.svg?post_id=1254727&theme=';
        const startupBase = document.querySelector('.startup-base img');
        const startupBaseEmbed = 'https://statics.startupbase.io/site/badges/featured-on-sb';
        const reflectTheme = () => {
          const dark = root.dataset.theme === 'dark';
          toggle.setAttribute('aria-pressed', String(dark));
          toggle.setAttribute('aria-label', dark ? 'Switch to light theme' : 'Switch to dark theme');
          themeColor.content = dark ? '#111418' : '#E7F2EC';
          if (badge) badge.src = dark ? '/badges/app-store-white.svg' : '/badges/app-store-black.svg';
          if (productHunt) productHunt.src = productHuntEmbed + (dark ? 'neutral' : 'light');
          if (startupBase) startupBase.src = startupBaseEmbed + (dark ? '-neutral.svg' : '.svg');
        };
        toggle.hidden = false;
        reflectTheme();
        toggle.addEventListener('click', () => {
          root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          localStorage.setItem('theme', root.dataset.theme);
          reflectTheme();
        });

        const menu = document.querySelector('.menu-toggle');
        const setMenu = (open) => {
          menu.setAttribute('aria-expanded', String(open));
          menu.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        };
        menu.hidden = false;
        menu.addEventListener('click', () => setMenu(menu.getAttribute('aria-expanded') !== 'true'));
        document.getElementById('nav-menu').addEventListener('click', () => setMenu(false));
        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape' || menu.getAttribute('aria-expanded') !== 'true') return;
          setMenu(false);
          menu.focus();
        });
      }
    </script>
  </body>
</html>
