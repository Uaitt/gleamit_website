---
const appStoreUrl = 'https://apps.apple.com/app/id6798220310';
const googlePlayUrl = 'https://play.google.com/store/apps/details?id=com.kirami.app';
---

<div class="badges">
  <a class="badge" href={appStoreUrl}>
    <img class="app-store" src="/badges/app-store-black.svg" alt="Download on the App Store" width="168" height="56" />
  </a>
  <a class="badge" href={googlePlayUrl}>
    <img src="/badges/google-play.svg" alt="Get it on Google Play" width="189" height="56" />
  </a>
</div>
