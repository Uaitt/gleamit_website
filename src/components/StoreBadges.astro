---
export const appStoreUrl = 'https://apps.apple.com/app/id6798220310';
export const googlePlayUrl = 'https://play.google.com/store/apps/details?id=com.kirami.app';
---

<div class="badges">
  <a class="badge" href={appStoreUrl}>
    <picture>
      <source srcset="/badges/app-store-white.svg" media="(prefers-color-scheme: dark)" />
      <img src="/badges/app-store-black.svg" alt="Download on the App Store" width="168" height="56" />
    </picture>
  </a>
  <a class="badge" href={googlePlayUrl}>
    <img src="/badges/google-play.svg" alt="Get it on Google Play" width="189" height="56" />
  </a>
</div>
