---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found - Gleamit" description="This page does not exist on gleamit.app.">
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">404</span>
      <h1>There is no page here.</h1>
      <p class="lead">The address may be old or mistyped. The <a href="/">home page</a> is still where it was.</p>
    </div>
  </section>
</Base>
