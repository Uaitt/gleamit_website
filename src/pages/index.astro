---
import Base from '../layouts/Base.astro';

const lead =
  'A 2-minute brushing timer, streaks, a 32-tooth map, smile photos, dentist visits and documents. No account, no server, no ads.';
---

<Base
  title="Gleamit - Your mouth, tracked privately"
  description={lead}
>
  <section class="hero">
    <div class="wrap">
      <span class="eyebrow">Oral hygiene tracker · Android &amp; iOS</span>
      <h1>Your mouth, over time. On your phone, and nowhere else.</h1>
      <p class="lead">{lead}</p>
      <div class="badges">
        <a class="badge" href="https://apps.apple.com/app/id6798220310">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16.4 12.6c0-2.3 1.9-3.4 2-3.5-1.1-1.6-2.8-1.8-3.4-1.8-1.4-.1-2.8.9-3.5.9-.7 0-1.9-.8-3.1-.8-1.6 0-3 .9-3.9 2.4-1.7 2.9-.4 7.2 1.2 9.6.8 1.2 1.7 2.5 3 2.4 1.2 0 1.7-.8 3.1-.8s1.9.8 3.1.8c1.3 0 2.1-1.2 2.9-2.3.9-1.3 1.3-2.6 1.3-2.7 0 0-2.7-1-2.7-4.2zM14.2 5.8c.6-.8 1.1-1.8 1-2.8-.9 0-2 .6-2.7 1.4-.6.7-1.1 1.7-1 2.7 1 .1 2.1-.5 2.7-1.3z"/></svg>
          <span><small>Download on the</small><b>App Store</b></span>
        </a>
        <a class="badge" href="https://play.google.com/store/apps/details?id=com.kirami.app">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.6 2.3 13.3 12l-9.7 9.7c-.4-.2-.6-.7-.6-1.2V3.5c0-.5.2-1 .6-1.2zM14.7 13.4l2.7 2.7-11.5 6.6c-.5.3-1 .3-1.4.1l10.2-9.4zM17.4 7.9l-2.7 2.7L4.5 1.2c.4-.2.9-.2 1.4.1l11.5 6.6zM18.6 8.6l2.9 1.7c1 .6 1 1.9 0 2.5l-2.9 1.7L15.4 12l3.2-3.4z"/></svg>
          <span><small>Get it on</small><b>Google Play</b></span>
        </a>
      </div>
      <p class="fine">Free to use. One optional €9.99 unlock, no subscription.</p>
    </div>
  </section>
</Base>
